#!/bin/bash
# 飞书消息管理命令
# 用法: feishu <command>

INBOX_FILE="$HOME/.config/feishu/inbox.json"
PYTHON="$HOME/.hermes/scripts/feishu-server.py"

case "$1" in
    start)
        echo "启动飞书服务..."
        nohup python3 "$PYTHON" > "$HOME/.config/feishu/server.log" 2>&1 &
        echo $! > "$HOME/.config/feishu/server.pid"
        echo "✅ 已启动 (PID: $(cat $HOME/.config/feishu/server.pid))"
        echo "日志: tail -f ~/.config/feishu/server.log"
        ;;
    stop)
        if [ -f "$HOME/.config/feishu/server.pid" ]; then
            kill $(cat "$HOME/.config/feishu/server.pid") 2>/dev/null && echo "✅ 已停止"
            rm -f "$HOME/.config/feishu/server.pid"
        fi
        ;;
    status)
        if [ -f "$HOME/.config/feishu/server.pid" ] && kill -0 $(cat "$HOME/.config/feishu/server.pid") 2>/dev/null; then
            echo "✅ 运行中 (PID: $(cat $HOME/.config/feishu/server.pid))"
        else
            echo "❌ 未运行"
        fi
        ;;
    inbox|list|ls)
        if [ -f "$INBOX_FILE" ]; then
            echo "最近收到的消息："
            python3 << 'PY'
import json, sys
try:
    with open("""$INBOX_FILE""", 'r', encoding='utf-8') as f:
        inbox = json.load(f)
    for i, msg in enumerate(inbox[-20:], 1):
        time = msg['time'][-8:]
        text = msg['text'][:60].replace('\n', ' ')
        print(f"{i}. [{time}] {text}")
except Exception as e:
    print(f"错误: {e}")
PY
        else
            echo "收件箱为空"
        fi
        ;;
    reply)
        if [ -z "$2" ]; then
            echo "用法: feishu reply '回复内容'"
            exit 1
        fi
        python3 << PY
import json, urllib.request, os

inbox_file = """$INBOX_FILE"""
reply_text = """$2"""

try:
    with open(inbox_file, 'r') as f:
        inbox = json.load(f)
    if not inbox:
        print("没有消息可回复")
        exit(1)
    
    last_msg = inbox[-1]
    chat_id = last_msg['chat_id']
    msg_id = last_msg['msg_id']
    
    # 读取配置
    with open(os.path.expanduser("~/.config/feishu/.env")) as f:
        config = dict(line.strip().split('=', 1) for line in f if line.strip() and not line.startswith('#'))
    
    # 获取token
    url = "https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal"
    data = json.dumps({"app_id": config['FEISHU_APP_ID'], "app_secret": config['FEISHU_APP_SECRET']}).encode()
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
    
    with urllib.request.urlopen(req) as resp:
        token = json.loads(resp.read())['tenant_access_token']
    
    # 发送回复
    url2 = "https://open.feishu.cn/open-apis/im/v1/messages"
    payload = {
        "receive_id": chat_id,
        "msg_type": "text",
        "content": json.dumps({"text": reply_text}),
        "reply_message_id": msg_id
    }
    req2 = urllib.request.Request(url2, data=json.dumps(payload).encode(), 
                                   headers={"Content-Type": "application/json", "Authorization": f"Bearer {token}"})
    
    with urllib.request.urlopen(req2) as resp:
        result = json.loads(resp.read())
        print("✅ 回复成功" if result['code'] == 0 else f"❌ 失败: {result.get('msg')}")
        
except Exception as e:
    print(f"❌ 错误: {e}")
PY
        ;;
    log)
        tail -f "$HOME/.config/feishu/server.log"
        ;;
    *)
        echo "飞书机器人管理命令"
        echo ""
        echo "用法: feishu <command>"
        echo ""
        echo "命令:"
        echo "  start              启动服务"
        echo "  stop               停止服务"
        echo "  status             查看状态"
        echo "  inbox, list, ls    查看收到的消息"
        echo "  reply '内容'        回复最后一条消息"
        echo "  log                查看实时日志"
        ;;
esac
