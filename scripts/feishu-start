#!/bin/bash
# 启动飞书机器人服务

LOG_FILE="$HOME/.config/feishu/bot.log"
PID_FILE="$HOME/.config/feishu/bot.pid"

case "$1" in
    start)
        if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
            echo "飞书机器人已经在运行 (PID: $(cat $PID_FILE))"
            exit 1
        fi
        
        echo "启动飞书机器人服务..."
        nohup python3 "$HOME/.hermes/scripts/feishu-bot.py" > "$LOG_FILE" 2>&1 &
        echo $! > "$PID_FILE"
        echo "✅ 已启动，PID: $(cat $PID_FILE)"
        echo "日志: tail -f $LOG_FILE"
        ;;
    stop)
        if [ -f "$PID_FILE" ]; then
            kill $(cat "$PID_FILE") 2>/dev/null && echo "✅ 已停止"
            rm -f "$PID_FILE"
        else
            echo "没有运行中的服务"
        fi
        ;;
    status)
        if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
            echo "✅ 飞书机器人运行中 (PID: $(cat $PID_FILE))"
            echo "最近日志:"
            tail -5 "$LOG_FILE"
        else
            echo "❌ 飞书机器人未运行"
        fi
        ;;
    log)
        tail -f "$LOG_FILE"
        ;;
    *)
        echo "用法: feishu-start {start|stop|status|log}"
        ;;
esac
