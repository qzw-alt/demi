#!/bin/bash
# 飞书回复工具 - 回复最后收到的消息

INBOX_FILE="$HOME/.config/feishu/inbox.json"
PYTHON_SCRIPT="$HOME/.hermes/scripts/feishu-bot.py"

if [ ! -f "$INBOX_FILE" ]; then
    echo "没有待回复的消息"
    exit 1
fi

# 获取最后一条消息
LAST_MSG=$(python3 -c "
import json
import sys
try:
    with open('$INBOX_FILE') as f:
        inbox = json.load(f)
    if inbox:
        last = inbox[-1]
        print(json.dumps(last))
    else:
        print('{}')
except Exception as e:
    print('{}')
")

if [ "$LAST_MSG" = "{}" ]; then
    echo "没有消息需要回复"
    exit 1
fi

CHAT_ID=$(echo "$LAST_MSG" | python3 -c "import json,sys; print(json.load(sys.stdin).get('chat_id',''))")
MSG_ID=$(echo "$LAST_MSG" | python3 -c "import json,sys; print(json.load(sys.stdin).get('msg_id',''))")
TEXT=$(echo "$LAST_MSG" | python3 -c "import json,sys; print(json.load(sys.stdin).get('text',''))")
SENDER=$(echo "$LAST_MSG" | python3 -c "import json,sys; print(json.load(sys.stdin).get('sender',''))")

echo "最后收到的消息:"
echo "  发送者: $SENDER"
echo "  内容: $TEXT"
echo ""

if [ -z "$1" ]; then
    echo "用法: feishu-reply '你的回复内容'"
    exit 1
fi

REPLY_TEXT="$1"

# 发送回复
python3 << PYCODE
import json
import urllib.request
import os

config = {}
with open(os.path.expanduser("~/.config/feishu/.env")) as f:
    for line in f:
        if line.strip() and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            config[key] = value

app_id = config.get("FEISHU_APP_ID", "")
app_secret = config.get("FEISHU_APP_SECRET", "")

# 获取token
url = "https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal"
data = json.dumps({"app_id": app_id, "app_secret": app_secret}).encode()
req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"}, method="POST")

try:
    with urllib.request.urlopen(req, timeout=30) as resp:
        result = json.loads(resp.read().decode())
        token = result.get("tenant_access_token")
        
        # 发送回复
        url2 = "https://open.feishu.cn/open-apis/im/v1/messages"
        payload = {
            "receive_id": "$CHAT_ID",
            "msg_type": "text",
            "content": json.dumps({"text": "$REPLY_TEXT"}),
            "reply_message_id": "$MSG_ID"
        }
        req2 = urllib.request.Request(
            url2,
            data=json.dumps(payload).encode(),
            headers={"Content-Type": "application/json", "Authorization": f"Bearer {token}"},
            method="POST"
        )
        with urllib.request.urlopen(req2, timeout=30) as resp2:
            result2 = json.loads(resp2.read().decode())
            if result2.get("code") == 0:
                print("✅ 回复发送成功")
            else:
                print(f"❌ 发送失败: {result2.get('msg')}")
except Exception as e:
    print(f"❌ 错误: {e}")
PYCODE
