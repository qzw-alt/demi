# Sensitive directories - never back up
cache/
audio_cache/
image_cache/
sandboxes/
logs/
sessions/
memories/
memory/
memory_backup_*/
migration/

# Runtime locks
*.lock
gateway.pid
gateway_state.json

# Environment files (not tracked - use .env.example instead)
.env
.env.*

# Database files
*.db
*.db-*
state.db*
kanban.db*

# OS files
.DS_Store
Thumbs.db
